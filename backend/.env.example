# ─────────────────────────────────────────────────────────────────────────────
# Trading App — environment configuration
# Copy this file to `.env` and fill in values. NEVER commit `.env` (gitignored).
# Your Groww key/secret are live credentials to your real brokerage account —
# keep them on your machine only. Secrets are never sent to the frontend or logged.
# ─────────────────────────────────────────────────────────────────────────────

# Server
PORT=8080

# Trading mode: "paper" (default, safe) or "live" (part of the triple-gate)
TRADING_MODE=paper

# Broker adapter: "mock" (synthetic data, no creds) or "groww" (official API)
BROKER=mock

# Account / risk defaults (rupees and percentages)
CAPITAL=50000
RISK_PER_TRADE_PCT=1
MAX_DAILY_LOSS_PCT=2
MIN_RISK_REWARD=2
MAX_TRADES_PER_DAY=5
MAX_OPEN_TRADES=3
MAX_CONSECUTIVE_LOSSES=3

# Cost model for paper trading / backtests
BROKERAGE_PER_ORDER=20
SLIPPAGE_BPS=5

# ─── Groww API (official) — leave blank to stay in mock mode ──────────────────
# Get an API key + secret from the Groww Cloud → API keys page. Do NOT hardcode.
GROWW_API_BASE=https://api.groww.in/v1
GROWW_API_KEY=
GROWW_API_SECRET=
# Alternatives to key+secret: a TOTP secret (TOTP flow) or a ready daily token.
GROWW_TOTP_SECRET=
GROWW_ACCESS_TOKEN=
# Stop-loss-market order type enum (confirm against your account before live use)
GROWW_STOP_ORDER_TYPE=SL_M

# Live trading is OFF unless this is "true" AND mode is "live" AND a token exists.
# A deliberate triple-gate. Keep off until you are ready.
ENABLE_LIVE_TRADING=false

# ─── Auth / security ─────────────────────────────────────────────────────────
# AUTH_ENABLED=false → single-user localhost (implicit admin, no login screen).
# Set true to require login. On first run an admin is bootstrapped and its
# one-time password is printed to the console (or set ADMIN_EMAIL/ADMIN_PASSWORD).
AUTH_ENABLED=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Signs sessions (JWT) and derives the token-encryption key. Set a fixed random
# value so logins and the stored Groww token survive restarts. If blank, one is
# generated and persisted locally.
APP_SECRET=
JWT_TTL_HOURS=12

# Storage: "sqlite" (Node built-in node:sqlite) or "json" (file).
STORAGE=sqlite

# ─── Alerts (all optional & free; no-op when blank, never logged) ────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_EMAIL_TO=
